Algoritmo SumaDosNumeros
	
	// 1. Declarar las variables (usamos 'Real' para que acepte decimales también)
	Definir numero1, numero2, resultado Como Real
	
	// 2. Entrada: Pedir los datos al usuario
	Escribir "Por favor, ingrese el primer numero:"
	Leer numero1
	
	Escribir "Por favor, ingrese el segundo numero:"
	Leer numero2
	
	// 3. Proceso: Realizar la suma (En PSeInt se usa la flecha <- para asignar valores)
	resultado <- numero1 + numero2
	
	// 4. Salida: Mostrar el resultado en pantalla
	Escribir "El resultado de la suma es: ", resultado
	
FinAlgoritmo
